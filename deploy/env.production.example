# Production-oriented env template for Coolify / docker-compose.prod.yml.
# Copy values into the Coolify UI (or a real secret store). Do not commit real secrets.
# File name avoids `.env.*` gitignore.

NODE_ENV=production

# --- API ---
PORT=3000
# Comma-separated browser origins (no *). Must include the public web origin.
CORS_ORIGIN=https://checkout.example.com
# Behind Coolify/nginx ONLY: trust proxy hops so throttler sees real clients via X-Forwarded-For.
# Leave unset/false when the API is published directly (clients can spoof X-Forwarded-For).
# compose.prod overrides this to false because ports are published on the host.
TRUST_PROXY=1

DB_HOST=postgres
DB_PORT=5432
DB_USER=checkout
DB_PASSWORD=checkout
DB_NAME=checkout

# OpenAPI UI at /docs (default on). Set ENABLE_SWAGGER=0 to disable docs and Swagger CSP.
ENABLE_SWAGGER=1

# Use a non-guest user/password in real Coolify deployments.
# Match RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS on the RabbitMQ service.
# docker-compose.prod.yml uses checkout:checkout for local prod smoke.
RABBITMQ_URL=amqp://checkout:checkout@rabbitmq:5672

WOMPI_BASE_URL=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_prod_replace_me
WOMPI_PRIVATE_KEY=prv_prod_replace_me
WOMPI_INTEGRITY_SECRET=prod_integrity_replace_me
WOMPI_EVENTS_SECRET=prod_events_replace_me
WEBHOOK_MAX_SKEW_SECONDS=300

# --- Worker (same DB + Wompi + RabbitMQ; Events URL points at the API) ---
WORKER_PORT=3001
STUCK_PENDING_AFTER_MS=120000
ORPHAN_PENDING_TTL_MS=1800000
JOB_INTERVAL_MS=60000
OUTBOX_POLL_MS=5000

# --- Web (build-arg only; rebuild image when this changes) ---
# VITE_API_URL=https://api.example.com
