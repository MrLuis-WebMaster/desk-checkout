{
  "name": "checkout-app",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @checkout/api db:migrate",
    "db:seed": "pnpm --filter @checkout/api db:seed"
  },
  "devDependencies": {
    "turbo": "2.11.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
