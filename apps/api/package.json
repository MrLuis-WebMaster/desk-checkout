{
  "name": "@checkout/api",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#shared/*": {
      "types": "./src/shared/*",
      "default": "./dist/shared/*"
    },
    "#modules/*": {
      "types": "./src/modules/*",
      "default": "./dist/modules/*"
    },
    "#config/*": {
      "types": "./src/config/*",
      "default": "./dist/config/*"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:cov": "jest --config jest.config.cjs --coverage",
    "db:migrate": "tsc -p tsconfig.json && typeorm migration:run -d dist/shared/infrastructure/persistence/typeorm.data-source.js",
    "db:seed": "tsc -p tsconfig.json && node dist/shared/infrastructure/persistence/seed.js"
  },
  "dependencies": {
    "@checkout/contracts": "workspace:*",
    "@checkout/messaging": "workspace:*",
    "@checkout/settlement": "workspace:*",
    "@checkout/settlement-typeorm": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pg": "8.16.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.27",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@checkout/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.5",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.0",
    "jest": "29.7.0",
    "typescript": "7.0.2"
  }
}
